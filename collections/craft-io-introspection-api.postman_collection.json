        {
          "id": "f1df1fd0-c5aa-4e81-ae25-d3d39b91fecd",
          "name": "Get My Api Key",
          "request": {
            "name": "Get My Api Key",
            "description": {
              "content": "Returns the current API key's authorization context — its bound user,\ngranted scopes, and any resource-scope narrowing. Useful for AI clients\n(MCP) to hide tools that the key cannot use, instead of failing at the\nfirst request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "me",
                "api-key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "e2070c66-dfa9-421e-b862-00eba8ef4c6e",
              "name": "API key introspection",
              "originalRequest": {
