            "method": "GET",
            "url": "/portfolios/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get the list of your account’s portfolios and the workspaces they are connected with"
        },
        {
          "info": {
            "name": "GetPortfolioCustomFields",
